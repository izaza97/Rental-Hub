# ============================================================================
# Konfigurasi Environment - Website Client / Pelanggan (Next.js)
# Salin file ini menjadi .env.local (lokal) / isi di Vercel Project Settings.
# Data layer: PostgreSQL Supabase via `pg` (menggantikan SQLite & MySQL localhost).
# ============================================================================

# 1) Koneksi database utama (Supabase → Project Settings → Database → Connection string → URI)
#    Untuk Vercel/serverless gunakan POOLER (port 6543, transaction mode).
#    Contoh: postgresql://postgres.abcdefghijklmn:password@aws-0-xx-xx.pooler.supabase.com:6543/postgres
DATABASE_URL=

# 2) Supabase API (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role = akses penuh server-side. JANGAN pernah pakai prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
