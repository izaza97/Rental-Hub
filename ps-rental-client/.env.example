# ============================================================================
# Konfigurasi Database - Website Client / Pelanggan (Next.js)
# Salin file ini menjadi .env.local jika ingin memakai MySQL (XAMPP/Laragon)
# Default tanpa .env.local: otomatis memakai SQLite (../database/ps_rental_hub.db)
# ============================================================================

# Pilihan: sqlite | mysql
DB_DRIVER=sqlite

# Jika DB_DRIVER=mysql (setelah import database/ps_rental_hub.sql ke phpMyAdmin):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ps_rental_hub
