// ============================================================================
// Prisma Schema - PS Rental Hub (Next.js Admin & Client)
// Kelompok 12 UNINDRA - SRS v1.0
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // Bisa diganti "sqlite" untuk mode lokal tanpa server MySQL
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String    @db.VarChar(100)
  role         String    @default("Operator")
  status       String    @default("Aktif")
  lastActive   DateTime? @map("last_active")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("users")
}

model Unit {
  id           Int           @id @default(autoincrement())
  code         String        @unique @db.VarChar(20)
  name         String        @db.VarChar(50)
  psType       String        @default("PS5") @map("ps_type")
  roomType     String        @default("Reguler") @map("room_type")
  pricePerHour Decimal       @map("price_per_hour") @db.Decimal(12, 2)
  status       String        @default("Tersedia")
  features     String?       @db.VarChar(255)
  createdAt    DateTime      @default(now()) @map("created_at")
  transactions Transaction[]

  @@map("units")
}

model Customer {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(100)
  nik          String?       @db.VarChar(30)
  phone        String?       @db.VarChar(20)
  address      String?       @db.VarChar(255)
  points       Int           @default(0)
  createdAt    DateTime      @default(now()) @map("created_at")
  transactions Transaction[]

  @@map("customers")
}

model Transaction {
  id             Int                @id @default(autoincrement())
  invoiceCode    String             @unique @map("invoice_code") @db.VarChar(25)
  customerId     Int?               @map("customer_id")
  customerName   String             @map("customer_name") @db.VarChar(100)
  customerPhone  String?            @map("customer_phone") @db.VarChar(20)
  unitId         Int?               @map("unit_id")
  unitName       String             @map("unit_name") @db.VarChar(50)
  bookingSource  String             @default("Admin POS") @map("booking_source")
  startTime      DateTime           @map("start_time")
  endTime        DateTime           @map("end_time")
  returnTime     DateTime?          @map("return_time")
  durationHours  Decimal            @map("duration_hours") @db.Decimal(6, 2)
  pricePerHour   Decimal            @map("price_per_hour") @db.Decimal(12, 2)
  addonsTotal    Decimal            @default(0) @map("addons_total") @db.Decimal(14, 2)
  subtotal       Decimal            @default(0) @db.Decimal(14, 2)
  discount       Decimal            @default(0) @db.Decimal(14, 2)
  penalty        Decimal            @default(0) @db.Decimal(14, 2)
  total          Decimal            @default(0) @db.Decimal(14, 2)
  paymentStatus  String             @default("Lunas") @map("payment_status")
  paymentMethod  String             @default("cash") @map("payment_method")
  createdBy      String             @default("system") @map("created_by")
  createdAt      DateTime           @default(now()) @map("created_at")
  customer       Customer?          @relation(fields: [customerId], references: [id])
  unit           Unit?              @relation(fields: [unitId], references: [id])
  addons         TransactionAddon[]

  @@map("transactions")
}

model Stock {
  id        Int                @id @default(autoincrement())
  name      String             @db.VarChar(100)
  price     Decimal            @db.Decimal(12, 2)
  qty       Int                @default(0)
  category  String             @default("Aksesori")
  sold      Int                @default(0)
  createdAt DateTime           @default(now()) @map("created_at")
  addons    TransactionAddon[]

  @@map("stock")
}

model TransactionAddon {
  id            Int         @id @default(autoincrement())
  transactionId Int         @map("transaction_id")
  stockId       Int?        @map("stock_id")
  itemName      String      @map("item_name") @db.VarChar(100)
  price         Decimal     @db.Decimal(12, 2)
  qty           Int         @default(1)
  subtotal      Decimal     @db.Decimal(14, 2)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  stock         Stock?      @relation(fields: [stockId], references: [id])

  @@map("transaction_addons")
}

model Promo {
  id              Int       @id @default(autoincrement())
  code            String    @unique @db.VarChar(30)
  discountPercent Decimal   @map("discount_percent") @db.Decimal(5, 2)
  description     String?   @db.VarChar(255)
  expiredAt       DateTime? @map("expired_at")
  usedCount       Int       @default(0) @map("used_count")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("promos")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  username  String   @db.VarChar(50)
  action    String   @db.VarChar(100)
  detail    String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}

model Deposit {
  id            Int       @id @default(autoincrement())
  invoiceCode   String?   @map("invoice_code") @db.VarChar(25)
  unitName      String    @map("unit_name") @db.VarChar(50)
  customerName  String    @map("customer_name") @db.VarChar(100)
  customerNik   String?   @map("customer_nik") @db.VarChar(30)
  depositAmount Decimal   @map("deposit_amount") @db.Decimal(14, 2)
  status        String    @default("Ditahan")
  returnDate    DateTime? @map("return_date")
  notes         String?   @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("deposits")
}

model Game {
  id        Int     @id @default(autoincrement())
  title     String  @db.VarChar(100)
  platform  String  @default("PS5")
  genre     String  @db.VarChar(60)
  rating    Decimal @default(4.8) @db.Decimal(3, 1)
  players   String  @default("1-2 Pemain")
  isPopular Boolean @default(true) @map("is_popular")

  @@map("games")
}

model GameRequest {
  id             Int      @id @default(autoincrement())
  customerName   String   @map("customer_name") @db.VarChar(100)
  gameTitle      String   @map("game_title") @db.VarChar(120)
  platform       String   @default("PS5")
  unitPreference String?  @map("unit_preference")
  status         String   @default("Menunggu")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("game_requests")
}
